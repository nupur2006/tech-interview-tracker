// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — Tech Interview Timeline Tracker
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum ApplicationStatus {
  BOOKMARKED
  APPLIED
  OA
  PHONE_SCREEN
  TECHNICAL
  ONSITE
  OFFER
  REJECTED
  WITHDRAWN
}

enum TimelineEventType {
  EMAIL
  CALL
  OA
  INTERVIEW
  OFFER
  REJECTION
  NOTE
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

enum ReminderType {
  FOLLOW_UP
  DEADLINE
  INTERVIEW_PREP
  GENERAL
}

// ─────────────────────────────────────────────────────────────────────────────
// NextAuth.js Required Models
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Application Models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // ── NextAuth relations ──
  accounts Account[]
  sessions Session[]

  // ── Domain relations ──
  applications Application[]
  companies    Company[]
  reminders    Reminder[]

  @@map("users")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  logo      String?
  industry  String?
  size      String?  // e.g. "1-50", "51-200", "201-1000", "1000+"
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name])
  @@index([userId])
  @@map("companies")
}

model Application {
  id          String            @id @default(cuid())
  role        String
  location    String?
  status      ApplicationStatus @default(BOOKMARKED)
  appliedDate DateTime?         @map("applied_date")
  jobUrl      String?           @map("job_url")
  notes       String?           @db.Text
  salaryMin   Int?              @map("salary_min")
  salaryMax   Int?              @map("salary_max")
  salaryCurrency String         @default("USD") @map("salary_currency")
  source      String?           // e.g. "LinkedIn", "Referral", "Company Website"
  userId      String            @map("user_id")
  companyId   String            @map("company_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // ── Relations ──
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  timelineEvents  TimelineEvent[]
  interviews      Interview[]
  reminders       Reminder[]

  @@index([userId])
  @@index([companyId])
  @@index([userId, status])
  @@index([userId, appliedDate])
  @@map("applications")
}

model Contact {
  id            String  @id @default(cuid())
  name          String
  email         String?
  phone         String?
  linkedIn      String? @map("linkedin")
  role          String? // Contact's job title/role at the company
  relationship  String? // e.g. "Recruiter", "Hiring Manager", "Referral"
  applicationId String  @map("application_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // ── Relations ──
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("contacts")
}

model TimelineEvent {
  id            String            @id @default(cuid())
  type          TimelineEventType
  date          DateTime
  title         String
  description   String?           @db.Text
  applicationId String            @map("application_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  // ── Relations ──
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, date])
  @@map("timeline_events")
}

model Interview {
  id              String           @id @default(cuid())
  round           Int              @default(1)
  type            InterviewType
  scheduledAt     DateTime         @map("scheduled_at")
  durationMinutes Int?             @default(60) @map("duration_minutes")
  location        String?          // Physical location or virtual meeting link
  interviewerName String?          @map("interviewer_name")
  interviewerRole String?          @map("interviewer_role")
  outcome         InterviewOutcome @default(PENDING)
  notes           String?          @db.Text
  applicationId   String           @map("application_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // ── Relations ──
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([applicationId, round])
  @@map("interviews")
}

model Reminder {
  id            String       @id @default(cuid())
  title         String
  dueDate       DateTime     @map("due_date")
  type          ReminderType @default(GENERAL)
  isCompleted   Boolean      @default(false) @map("is_completed")
  userId        String       @map("user_id")
  applicationId String?      @map("application_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // ── Relations ──
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isCompleted])
  @@index([userId, dueDate])
  @@index([applicationId])
  @@map("reminders")
}
